{
	"name": "loweryourrent",
	"private": true,
	"version": "0.0.1",
	"packageManager": "bun@1.3.12",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun run scripts/migrate.ts && bun ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"seed:zip": "bun run scripts/seed-zip-county.ts",
		"seed:fmr": "bun run scripts/seed-hud-fmr.ts",
		"seed:acs": "bun run scripts/seed-acs-rent.ts",
		"seed:vacancy": "bun run scripts/seed-vacancy.ts",
		"seed:permits": "bun run scripts/seed-permits.ts",
		"seed:population": "bun run scripts/seed-population.ts",
		"seed:templates": "bun run scripts/seed-email-templates.ts",
		"seed:all": "bun run scripts/seed-all.ts",
		"admin:password": "bun run scripts/admin-set-password.ts",
		"test": "bun test",
		"test:a11y:axe": "playwright test --config playwright.a11y.config.ts",
		"test:a11y:pa11y": "bun run scripts/a11y/with-preview.ts -- pa11y-ci --config .pa11yci.json",
		"test:a11y:lighthouse": "bun run scripts/a11y/with-preview.ts -- bun run scripts/a11y/lighthouse.ts",
		"test:a11y": "bun run test:a11y:axe && bun run test:a11y:pa11y && bun run test:a11y:lighthouse"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@playwright/test": "^1.60.0",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/bun": "^1.3.12",
		"@types/leaflet": "^1.9.21",
		"@types/marked": "^6.0.0",
		"@types/node": "^25.6.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"csv-parse": "^6.2.1",
		"drizzle-kit": "^0.31.10",
		"lighthouse": "^13.3.0",
		"pa11y-ci": "^4.1.1",
		"sharp": "^0.34.5",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"xlsx": "^0.18.5"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"argon2": "^0.44.0",
		"drizzle-orm": "^0.45.2",
		"isomorphic-dompurify": "^3.14.0",
		"leaflet": "^1.9.4",
		"marked": "^18.0.3",
		"parse-address": "^1.1.2",
		"postgres": "^3.4.9",
		"resend": "^6.12.3",
		"zod": "^4.3.6"
	}
}
