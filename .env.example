# --- Database ---
# Railway auto-injects DATABASE_URL in production. For local dev, run the Postgres in docker-compose.yml.
# REQUIRED in production — the app refuses to boot without it when NODE_ENV=production.
DATABASE_URL=postgres://lower:lower@localhost:5433/loweryourrent

# --- Admin (optional — leave blank to disable /admin) ---
# Generate with: bun run admin:password
# IMPORTANT: wrap the hash in SINGLE QUOTES — argon2 hashes contain `$` which
# dotenv would otherwise treat as variable references and silently mangle.
# Example: ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=1$...'
ADMIN_PASSWORD_HASH=

# --- Runtime ---
NODE_ENV=development
PUBLIC_APP_NAME=Lower Your Rent
# Set to `true` ONLY when the app is served behind Cloudflare. When true the
# CF-Connecting-IP header is trusted as the real client IP for rate limiting;
# otherwise it is ignored, since a client could spoof it to evade rate limits.
TRUST_CF_CONNECTING_IP=

# --- Cloudflare Turnstile (bot protection) ---
# Leave blank for local dev: the form works without the bot check.
# REQUIRED in production — the app refuses to boot without TURNSTILE_SECRET_KEY
# when NODE_ENV=production. Create an "Invisible" widget at dash.cloudflare.com
# → Turnstile and set both keys (TURNSTILE_SECRET_KEY as a Railway env var).
# To exercise the widget locally, use Cloudflare's always-pass test keys:
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Mapbox (address autocomplete + verification — optional) ---
# Leave blank for local dev: the address field falls back to free-typing and
# submit-time address verification is skipped.
# Production: create a token at account.mapbox.com → Tokens. It is used only
# server-side (the autocomplete proxy + submit check), so it never reaches the
# browser — a default public token (pk....) is fine.
MAPBOX_TOKEN=

# --- Email (Resend) — verification codes ---
# The negotiate flow emails a 6-digit code before generating negotiation emails.
# Leave RESEND_API_KEY / EMAIL_FROM blank for local dev: the code is printed to
# the server console ("[email] verification code for ...") instead of sent.
# REQUIRED in production — the app refuses to boot without RESEND_API_KEY and
# EMAIL_FROM when NODE_ENV=production. Create a key at resend.com → API Keys and
# verify the EMAIL_FROM domain, or sends fail.
RESEND_API_KEY=
EMAIL_FROM=Lower Your Rent <verify@loweryourrent.com>
# Secret pepper for hashing emails + codes at rest. Optional in dev (a fixed
# fallback is used). REQUIRED in production — the app refuses to boot without
# it when NODE_ENV=production. It is effectively permanent (rotating it breaks
# the verified-email dedup key), so set a strong random value once.
EMAIL_PEPPER=
